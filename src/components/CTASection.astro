---
interface Props {
  title: string;
  description: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
}

const { title, description, primaryLabel, primaryHref, secondaryLabel, secondaryHref } = Astro.props;
---

<section class="surface-panel mt-12 px-6 py-10 sm:px-10">
  <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl">
      <p class="kicker">Ready To Move</p>
      <h2 class="mt-4 font-display text-2xl text-ink sm:text-3xl">{title}</h2>
      <p class="mt-3 text-base leading-relaxed text-muted">{description}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={primaryHref} class="btn btn-primary">{primaryLabel}</a>
      <a href={secondaryHref} class="btn btn-secondary">{secondaryLabel}</a>
    </div>
  </div>
</section>
