---
interface Props {
  stepNumber: number;
  title: string;
  detail: string;
}

const { stepNumber, title, detail } = Astro.props;
---

<article class="surface-panel relative p-6">
  <p class="text-xs font-semibold tracking-[0.2em] text-muted uppercase">Step {stepNumber}</p>
  <h3 class="mt-2 font-display text-xl text-ink">{title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-muted">{detail}</p>
</article>
