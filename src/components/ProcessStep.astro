---
interface Props {
  stepNumber: number;
  title: string;
  detail: string;
}

const { stepNumber, title, detail } = Astro.props;
---

<article class="surface-panel relative isolate overflow-hidden p-6">
  <div
    class="absolute -right-4 -top-6 -z-10 select-none font-display text-[8rem] font-bold leading-none text-muted opacity-[0.04]"
  >
    {stepNumber}
  </div>
  <p class="text-xs font-semibold tracking-[0.2em] text-accent uppercase">
    Step {stepNumber}
  </p>
  <h3 class="mt-3 font-display text-xl text-ink">{title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-muted">{detail}</p>
</article>
