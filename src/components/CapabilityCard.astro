---
interface Props {
  title: string;
  summary: string;
  points: string[];
}

const { title, summary, points } = Astro.props;
---

<article class="surface-panel h-full p-6">
  <div
    class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accentSoft/60 text-accent ring-1 ring-accent/10"
  >
    <svg
      class="h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"></path>
    </svg>
  </div>
  <h3 class="font-display text-xl text-ink">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-muted">{summary}</p>
  <ul class="marked-list mt-4 list-disc text-sm text-ink/90">
    {points.map((point) => <li>{point}</li>)}
  </ul>
</article>
