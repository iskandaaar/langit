---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<div class="space-y-3">
  {
    items.map((item) => (
      <details class="surface-panel group p-5">
        <summary class="cursor-pointer list-none pr-8 text-sm font-semibold text-ink marker:hidden">
          {item.question}
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-muted">{item.answer}</p>
      </details>
    ))
  }
</div>
