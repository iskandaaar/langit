---
interface Props {
  title: string;
  description?: string;
  kicker?: string;
  headingTag?: 'h1' | 'h2';
}

const { title, description, kicker, headingTag = 'h2' } = Astro.props;
const HeadingTag = headingTag;
---

<header class="mb-8 max-w-3xl">
  {kicker ? <p class="kicker">{kicker}</p> : null}
  <HeadingTag class="mt-4 font-display text-2xl text-ink sm:text-3xl">{title}</HeadingTag>
  {description ? <p class="mt-3 text-base leading-relaxed text-muted sm:text-lg">{description}</p> : null}
</header>
