---
import CTASection from "../components/CTASection.astro";
import CapabilityCard from "../components/CapabilityCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Capabilities"
  description="Airworthy Supply capability coverage from consumables and rotables to engine inquiries and urgent AOG support."
>
  <section class="mt-12">
    <SectionHeader
      kicker="Capabilities"
      headingTag="h1"
      title="Coverage built for speed, trace, and accountability"
      description="Airworthy Supply brokers supply across APAC and beyond, with process discipline matched to each part class."
    />

    <div class="grid gap-5 md:grid-cols-2">
      <CapabilityCard
        title="Consumables & Expendables"
        summary="Fast-moving items where downtime and line-stop risk demand responsiveness."
        points={[
          "Repeat RFQ handling with stable vendor lanes",
          "Urgent-ready sourcing for short-notice maintenance",
          "Part and cert alignment checks before release",
        ]}
      />
      <CapabilityCard
        title="Rotables"
        summary="Higher-value parts where quality documentation and condition visibility are non-negotiable."
        points={[
          "Trace requirement reviewed before quote",
          "Certificate type clearly stated in offer",
          "Lead-time and stock status kept explicit",
        ]}
      />
      <CapabilityCard
        title="Engines"
        summary="Engine transactions are handled through a strict gate process and serious-buyer cadence."
        points={[
          "Disciplined intake and buyer qualification",
          "Structured document and entity checks",
          "Commercial handling with no speculative claims",
        ]}
      />
      <CapabilityCard
        title="AOG Desk"
        summary="Rapid escalation desk with direct ownership and clear status communication."
        points={[
          "Priority response path for AOG-tagged requests",
          "Decision-oriented updates, not generic check-ins",
          "Fallback options when primary source shifts",
        ]}
      />
    </div>
  </section>

  <CTASection
    title="Send one complete RFQ and we run the process end-to-end"
    description="Include part numbers, cert requirement, and needed-by time so we can move immediately."
    primaryLabel={siteConfig.cta.primaryLabel}
    primaryHref={siteConfig.cta.primaryHref}
    secondaryLabel={siteConfig.cta.secondaryLabel}
    secondaryHref={siteConfig.cta.secondaryHref}
  />
</BaseLayout>
