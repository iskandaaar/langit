---
import SectionHeader from "../components/SectionHeader.astro";
import { hasConfiguredTallyForm, tallyEmbedUrl } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const forwardedParams = new URLSearchParams(Astro.url.searchParams);
const contextualTitle = forwardedParams.get('inventory_title');
const contextualModel = forwardedParams.get('engine_model') || forwardedParams.get('part_number');
const contextualSource = forwardedParams.get('source_page');
const embedUrl = hasConfiguredTallyForm
  ? (() => {
      const url = new URL(tallyEmbedUrl);
      forwardedParams.forEach((value, key) => {
        url.searchParams.set(key, value);
      });
      return url.toString();
    })()
  : '';
---

<BaseLayout
  title="RFQ"
  description="Submit an Angkasa Supply RFQ through the embedded Tally form for structured aircraft parts and engine sourcing intake."
>
  <section class="mt-12">
    <SectionHeader
      kicker="Submit RFQ"
      headingTag="h1"
      title="Structured intake for faster sourcing"
      description="Use the form below so part details, cert requirements, and timing are captured in one pass."
    />

    {
      contextualTitle || contextualModel || contextualSource ? (
        <div class="surface-panel mb-5 p-5">
          <p class="kicker">Request Context</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            {
              contextualTitle
                ? `You are requesting follow-up on ${contextualTitle}${contextualModel ? ` (${contextualModel})` : ''}.`
                : contextualSource
                  ? `You arrived here from ${contextualSource}.`
                  : 'Context from the source page will be forwarded with this RFQ.'
            }
          </p>
        </div>
      ) : null
    }

    {
      hasConfiguredTallyForm ? (
        <div class="surface-panel overflow-hidden p-1">
          <iframe
            id="tally-embed"
            src={embedUrl}
            title="Angkasa Supply RFQ form"
            class="min-h-[900px] w-full rounded-[0.85rem] border-0 bg-white"
            loading="lazy"
          />
        </div>
      ) : (
        <div class="surface-panel p-6 sm:p-8">
          <p class="text-sm leading-relaxed text-muted sm:text-base">
            Tally form is not configured yet. Set{" "}
            <code>PUBLIC_TALLY_FORM_ID</code> in your environment or update
            <code>src/config/site.ts</code> with your form ID to enable this
            page.
          </p>
        </div>
      )
    }

    <p class="mt-4 text-sm text-muted">
      AOG? Put "AOG" in subject and include the needed-by time plus destination.
    </p>
  </section>
</BaseLayout>

<script is:inline>
  const iframe = document.getElementById("tally-embed");
  const allowedOrigins = new Set(["https://tally.so", "https://www.tally.so"]);

  if (iframe instanceof HTMLIFrameElement) {
    window.addEventListener("message", (event) => {
      if (!allowedOrigins.has(event.origin)) return;
      if (event.source !== iframe.contentWindow) return;

      const data = event.data;
      if (
        data?.type === "tally-form-height" &&
        typeof data.height === "number"
      ) {
        iframe.style.height = `${Math.max(data.height + 24, 900)}px`;
      }
    });
  }
</script>
