---
import ArticleCard from '../components/ArticleCard.astro';
import CapabilityCard from '../components/CapabilityCard.astro';
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import InventoryCard from '../components/InventoryCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { siteConfig, toAbsoluteSiteUrl } from '../config/site';
import { getFeaturedArticles, getFeaturedInventory, getInventoryCategoryPages, getServicePages } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';

const [servicePages, featuredInventory, featuredArticles] = await Promise.all([
  getServicePages(),
  getFeaturedInventory(6),
  getFeaturedArticles(3),
]);

const categoryPages = getInventoryCategoryPages();

const homepageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Aircraft Parts, Engines, and AOG Sourcing',
  url: toAbsoluteSiteUrl('/') ?? '/',
  description:
    'Langit Aero supports aircraft engine, rotable, consumable, and AOG sourcing with SEO-first inventory pages and a structured RFQ workflow.',
};
---

<BaseLayout
  title="Aircraft Parts, Engines, and AOG Sourcing | Langit Aero"
  description="Langit Aero supports aircraft parts, engine, and AOG sourcing across APAC with curated inventory pages, commercial service pages, and a structured RFQ workflow."
  jsonLd={homepageJsonLd}
>
  <Hero
    kicker="Aircraft Parts Brokerage | APAC"
    title="Inventory pages built to rank. RFQ workflows built to convert."
    subhead="Langit Aero helps operators, MROs, brokers, and asset buyers source engines, rotables, and consumables through a controlled supplier network with APAC-focused commercial support."
    primaryLabel="View Inventory"
    primaryHref="/inventory"
    secondaryLabel="Submit RFQ"
    secondaryHref="/rfq"
    badges={[
      'SEO-first inventory architecture',
      'AOG-ready desk routing',
      'Confidential supplier handling',
    ]}
    trustMetrics={[
      { value: '3', label: 'Core inventory categories live at launch' },
      { value: '10+', label: 'Curated listing pages seeded for long-tail demand' },
      { value: 'APAC', label: 'Primary commercial focus with global supplier reach' },
      { value: 'RFQ', label: 'Structured path for pricing, timing, and cert context' },
    ]}
    trustPoints={[
      {
        title: 'Searchable commercial pages',
        detail:
          'Service, category, and listing pages are written to support both search visibility and buyer decision-making.',
      },
      {
        title: 'No spreadsheet-dump inventory',
        detail:
          'Only curated, commercially useful listings are published publicly. Thin inventory stays out of the index.',
      },
    ]}
  />

  <section class="mt-16">
    <SectionHeader
      kicker="Services"
      title="Commercial entry points for the demand that matters"
      description="Stable service pages anchor broad intent, while listings capture exact model and part-number demand."
    />
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {
        servicePages.map((page) => (
          <CapabilityCard
            title={page.title}
            summary={page.heroIntro}
            points={page.highlights}
          />
        ))
      }
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      {servicePages.map((page) => <a href={`/${page.slug}`} class="btn btn-secondary">{page.title}</a>)}
    </div>
  </section>

  <section class="mt-16">
    <SectionHeader
      kicker="Inventory Categories"
      title="SEO hubs for engines, rotables, and consumables"
      description="Each category page combines useful copy, curated listings, and internal links so the site builds topical depth without publishing thin inventory."
    />
    <div class="grid gap-5 lg:grid-cols-3">
      {
        categoryPages.map((category) => (
          <article class="surface-panel p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted">
              Category Page
            </p>
            <h3 class="mt-4 font-display text-2xl text-ink">{category.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{category.intro}</p>
            <div class="mt-6">
              <a href={`/inventory/${category.slug}`} class="btn btn-secondary">
                Browse {category.title}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mt-16">
    <SectionHeader
      kicker="Featured Listings"
      title="Curated listing pages designed for exact-intent demand"
      description="Listings capture model, part number, condition, region, and RFQ intent without exposing confidential supplier detail."
    />
    <div class="grid gap-5 lg:grid-cols-3">
      {featuredInventory.map((item) => <InventoryCard item={item} />)}
    </div>
  </section>

  <section class="mt-16">
    <SectionHeader
      kicker="Support Content"
      title="Articles that strengthen buyer intent and internal linking"
      description="The first content cluster focuses on aviation condition language, engine buying workflow, and parts-class differences."
    />
    <div class="grid gap-5 lg:grid-cols-3">
      {featuredArticles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>

  <CTASection
    title="Need a specific part number or engine model?"
    description="Use the RFQ page so destination, needed-by timing, condition, and certification requirements are routed in one pass."
    primaryLabel={siteConfig.cta.primaryLabel}
    primaryHref={siteConfig.cta.primaryHref}
    secondaryLabel="Contact Desk"
    secondaryHref="/contact"
  />
</BaseLayout>
