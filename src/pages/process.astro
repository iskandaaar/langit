---
import CTASection from "../components/CTASection.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import ProcessStep from "../components/ProcessStep.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const faqItems = [
  {
    question: "What does verification include before quote?",
    answer:
      "Verification includes stock proof, cert type check, trace statement, lead-time confirmation, and bank/company identity matching.",
  },
  {
    question: "Can you process AOG requests outside local business hours?",
    answer:
      'Yes. Mark the request subject with "AOG" and include needed-by time and location. The desk shifts into rapid response workflow.',
  },
  {
    question: "Do you present unverified stock as confirmed inventory?",
    answer:
      "No. Unverified inventory is never represented as confirmed. We flag assumptions clearly before any commercial commitment.",
  },
];
---

<BaseLayout
  title="Process"
  description="Langit Aero process: RFQ intake, verification, quote, order, and shipment with transparent risk controls."
>
  <section class="mt-12">
    <SectionHeader
      kicker="How We Work"
      headingTag="h1"
      title="RFQ intake -> Verification -> Quote -> Order -> Ship"
      description="Every stage is designed to preserve speed while controlling sourcing risk and communication quality."
    />

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-5">
      <ProcessStep
        stepNumber={1}
        title="RFQ intake"
        detail="We log scope, urgency, destination, cert requirement, and buying entity details upfront."
      />
      <ProcessStep
        stepNumber={2}
        title="Verification"
        detail="We validate stock proof, cert type, trace statement, lead time, and bank/company match before quoting."
      />
      <ProcessStep
        stepNumber={3}
        title="Quote"
        detail="Commercial offer includes cert assumptions, lead-time expectation, validity, and exclusions."
      />
      <ProcessStep
        stepNumber={4}
        title="Order"
        detail="We confirm acceptance, compliance checks, and release conditions before shipment planning."
      />
      <ProcessStep
        stepNumber={5}
        title="Ship"
        detail="Dispatch is coordinated with document pack release and concise update milestones."
      />
    </div>
  </section>

  <section class="mt-14">
    <SectionHeader
      kicker="Verification Detail"
      title="What verification means in practice"
      description="This gate exists to reduce fraud risk, avoid false confirmations, and keep buyers protected."
    />
    <div class="surface-panel p-6 sm:p-8">
      <ul
        class="marked-list list-disc text-sm leading-relaxed text-ink/90 sm:text-base"
      >
        <li>
          <strong>Stock proof:</strong> timestamped evidence of availability before
          commercial commitment.
        </li>
        <li>
          <strong>Cert type:</strong> confirmation of 8130-3 / EASA Form 1 / CoC
          availability as applicable.
        </li>
        <li>
          <strong>Trace statement:</strong> documented source and chain visibility
          at quote stage.
        </li>
        <li>
          <strong>Lead time:</strong> declared with explicit caveats where upstream
          risk exists.
        </li>
        <li>
          <strong>Bank/company match:</strong> payee and legal entity checks completed
          before order release.
        </li>
      </ul>
    </div>
  </section>

  <section class="mt-14">
    <SectionHeader
      kicker="FAQ"
      title="Common process questions"
      description="If your case is unusual, send the RFQ with context and we will structure the path."
    />
    <FAQAccordion items={faqItems} />
  </section>

  <CTASection
    title="Ready to route your request through the desk?"
    description="Use the RFQ form so every required detail lands in one place from the first message."
    primaryLabel={siteConfig.cta.primaryLabel}
    primaryHref={siteConfig.cta.primaryHref}
    secondaryLabel={siteConfig.cta.secondaryLabel}
    secondaryHref={siteConfig.cta.secondaryHref}
  />
</BaseLayout>
