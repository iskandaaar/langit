---
import CTASection from '../components/CTASection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Langit Aero',
};
---

<BaseLayout
  title="About Langit Aero"
  description="Learn how Langit Aero approaches aircraft parts, engine, and AOG sourcing with commercial discipline and a controlled RFQ workflow."
  jsonLd={aboutJsonLd}
>
  <section class="mt-12">
    <SectionHeader
      kicker="About"
      headingTag="h1"
      title="Aviation sourcing built around clarity, not speculative stock language."
      description="Langit Aero is positioned as a focused brokerage partner for aircraft parts, engines, and AOG requirements across APAC, with a public site designed to attract qualified demand without exposing sensitive commercial detail."
    />

    <div class="grid gap-5 lg:grid-cols-[1.15fr_0.85fr]">
      <article class="surface-panel p-6 sm:p-8">
        <h2 class="font-display text-2xl text-ink">What the business is optimizing for</h2>
        <div class="rich-text mt-4">
          <p>
            The site is intentionally structured around service pages, category hubs, and curated listing pages because that is the mix most likely to rank and convert in aviation brokerage.
          </p>
          <p>
            Public pages establish topical depth and commercial credibility. The RFQ flow then carries the real transaction context: timing, certification, destination, condition, and alternate-stock needs.
          </p>
          <p>
            That balance matters in this niche. Buyers need enough public information to trust the inquiry process, but not every detail should be exposed before qualification.
          </p>
        </div>
      </article>

      <aside class="surface-panel p-6 sm:p-8">
        <h2 class="font-display text-2xl text-ink">Operating principles</h2>
        <ul class="marked-list mt-4 list-disc text-sm leading-relaxed text-ink/90">
          <li>Keep supplier identity and sensitive commercial detail controlled.</li>
          <li>Publish only listings with enough unique value to earn indexation.</li>
          <li>Use one structured RFQ path across engines, rotables, consumables, and AOG demand.</li>
          <li>Maintain clear condition, certification, and region context on public pages.</li>
        </ul>
      </aside>
    </div>
  </section>

  <CTASection
    title="Need to move from public page to active sourcing?"
    description="Use the RFQ flow to send the real commercial details without relying on generic capability claims."
    primaryLabel="Submit RFQ"
    primaryHref="/rfq"
    secondaryLabel="View Inventory"
    secondaryHref="/inventory"
  />
</BaseLayout>
